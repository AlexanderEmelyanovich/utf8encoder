[app]
title = UTF8 Encoder
package.name = utf8encoder
package.domain = org.example

source.dir = /content
source.include_exts = py

version = 1.0
requirements = python3,kivy

orientation = portrait
fullscreen = 0

android.api = 35
android.minapi = 24
android.archs = arm64-v8a

[buildozer]
log_level = 2
warn_on_root = 1
bin_dir = /content/bin
